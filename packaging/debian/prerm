#!/bin/sh
set -e

RESTART_MARKER=/run/legion-control-fand.restart-after-upgrade
RGB_RESTART_MARKER=/run/legion-control-rgbd.restart-after-upgrade

if [ "$1" = "upgrade" ] && command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet legion-control-fand.service; then
        install -m 0600 /dev/null "$RESTART_MARKER" || true
    fi
    if systemctl is-active --quiet legion-control-rgbd.service; then
        install -m 0600 /dev/null "$RGB_RESTART_MARKER" || true
    fi
else
    rm -f "$RESTART_MARKER" "$RGB_RESTART_MARKER"
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now legion-control-fand.service || true
    systemctl disable --now legion-control-rgbd.service || true
fi

if [ -x /usr/libexec/legion-control-fand ]; then
    /usr/libexec/legion-control-fand --restore-auto || true
fi

if [ -x /usr/libexec/legion-control-rgbd ]; then
    /usr/libexec/legion-control-rgbd --restore-static || true
fi

exit 0
