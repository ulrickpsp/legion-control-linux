[Unit]
Description=Legion Control keyboard lighting effect service
After=systemd-modules-load.service
ConditionPathExists=/sys/class/hidraw
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/libexec/legion-control-rgbd
ExecStopPost=/usr/libexec/legion-control-rgbd --restore-static
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
# The controller lives on /dev/hidrawN, so PrivateDevices cannot be used here.
# A closed device policy with a single allowance is the equivalent restriction.
DevicePolicy=closed
DeviceAllow=char-hidraw rw
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
InaccessiblePaths=-/etc/shadow -/etc/gshadow
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
